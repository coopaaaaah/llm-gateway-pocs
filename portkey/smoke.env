# Sourced by gateway.sh after .env and .env.aws.
# Portkey OSS takes provider credentials and guardrail config from request headers.
SMOKE_URL=http://localhost:8787/v1/chat/completions
SMOKE_MODEL=${HAIKU_MODEL_ID}
_portkey_guard="{\"default.contains\":{\"operator\":\"none\",\"words\":[\"${GUARDRAIL_CANARY}\"]},\"deny\":true}"
SMOKE_HEADERS=(
  -H "x-portkey-provider: bedrock"
  -H "x-portkey-aws-region: ${AWS_REGION}"
  -H "x-portkey-aws-access-key-id: ${AWS_ACCESS_KEY_ID}"
  -H "x-portkey-aws-secret-access-key: ${AWS_SECRET_ACCESS_KEY}"
  -H "x-portkey-aws-session-token: ${AWS_SESSION_TOKEN:-}"
  -H "x-portkey-config: {\"input_guardrails\":[${_portkey_guard}],\"output_guardrails\":[${_portkey_guard}]}"
)
# OSS has no virtual keys or rate limits; see README.md.
RATELIMIT_HEADERS=()
