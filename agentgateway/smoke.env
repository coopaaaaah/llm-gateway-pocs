# Sourced by gateway.sh after .env and .env.aws. Tokens come from the local dev issuer.
SMOKE_URL=http://localhost:4001/v1/chat/completions
SMOKE_MODEL=haiku
SMOKE_HEADERS=(-H "Authorization: Bearer $(mint_token poc)")
RATELIMIT_HEADERS=(-H "Authorization: Bearer $(mint_token poc-limited)")
TOKEN_RATELIMIT_HEADERS=(-H "Authorization: Bearer $(mint_token poc-tokens)")
# Requests that must be rejected before reaching the model.
AUTH_REJECT_CASES=(
  "no token|"
  "wrong audience|Authorization: Bearer $(mint_token poc some-other-service)"
  "not a JWT|Authorization: Bearer sk-not-a-jwt"
)
