# Copy to .env and fill in. AWS credentials do not go here: `./gateway.sh creds <profile>`
# writes short-lived credentials to .env.aws.

AWS_REGION=us-west-2

# Bedrock model IDs used by every gateway config and by the smoke tests.
SONNET_MODEL_ID=us.anthropic.claude-sonnet-5
HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Any request or response containing this string must be blocked by the gateway guardrail.
GUARDRAIL_CANARY=GATEWAY-POC-GUARDRAIL-CANARY

# Shared OTel collector exports here. Leave HONEYCOMB_API_KEY empty to log spans to stdout only.
HONEYCOMB_API_KEY=
HONEYCOMB_DATASET=llm-gateway-pocs

# Admin/master keys for gateways that need one. Change these.
LITELLM_MASTER_KEY=sk-litellm-poc-master
BIFROST_VIRTUAL_KEY=sk-bf-poc
